{
  "name": "@kvesto/schema",
  "version": "0.2.0",
  "description": "Versioned survey JSON format and shared Zod schemas for Kvesto.",
  "license": "MIT",
  "keywords": [
    "survey",
    "form",
    "json-schema",
    "zod",
    "kvesto"
  ],
  "homepage": "https://github.com/pavlovt/kvesto/tree/main/packages/schema#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavlovt/kvesto.git",
    "directory": "packages/schema"
  },
  "bugs": {
    "url": "https://github.com/pavlovt/kvesto/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./survey.schema.json": "./dist/survey.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/write-json-schema.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
