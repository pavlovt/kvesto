{
  "name": "@kvesto/editor",
  "version": "0.2.0",
  "description": "Embeddable visual survey editor for Kvesto: a Svelte 5 component, plus a prebuilt bundle for any framework.",
  "license": "MIT",
  "keywords": [
    "survey",
    "form-builder",
    "survey-editor",
    "svelte",
    "kvesto"
  ],
  "homepage": "https://github.com/pavlovt/kvesto/tree/main/packages/editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavlovt/kvesto.git",
    "directory": "packages/editor"
  },
  "bugs": {
    "url": "https://github.com/pavlovt/kvesto/issues"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./standalone": {
      "types": "./dist/standalone/index.d.ts",
      "default": "./dist/standalone/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.svelte"
  ],
  "scripts": {
    "build": "node ../../scripts/svelte-package-braceml.mjs && vite build -c vite.standalone.config.ts && node ../../scripts/standalone-types.mjs",
    "prepack": "pnpm run build",
    "typecheck": "node ../../scripts/svelte-check-braceml.mjs",
    "test": "vitest run",
    "test:e2e": "node --test test/e2e/drag.e2e.mjs"
  },
  "peerDependencies": {
    "svelte": "^5.20.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "dependencies": {
    "@kvesto/core": "workspace:^"
  },
  "devDependencies": {
    "@braceml/svelte": "^0.4.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "axe-core": "4.10.2",
    "happy-dom": "21.0.4",
    "playwright": "1.63.0",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "typescript": "5.9.3",
    "vite": "^7.3.8",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
