{
  "name": "@kvesto/react",
  "version": "0.3.0",
  "description": "React bindings for Kvesto: a useSurvey hook and a <Survey> component around the framework-agnostic core.",
  "license": "MIT",
  "keywords": [
    "survey",
    "form",
    "questionnaire",
    "kvesto",
    "react"
  ],
  "homepage": "https://github.com/pavlovt/kvesto/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavlovt/kvesto.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/pavlovt/kvesto/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kvesto/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "happy-dom": "21.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
