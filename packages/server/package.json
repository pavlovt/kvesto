{
  "name": "@kvesto/server",
  "version": "0.2.0",
  "description": "Kvesto REST API: Hono + Drizzle, SQLite by default, documented with OpenAPI.",
  "license": "MIT",
  "keywords": [
    "survey",
    "rest",
    "openapi",
    "hono",
    "sqlite",
    "kvesto"
  ],
  "homepage": "https://github.com/pavlovt/kvesto/tree/main/packages/server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavlovt/kvesto.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/pavlovt/kvesto/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kvesto-server": "./dist/serve.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "drizzle",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/serve.ts",
    "start": "node dist/serve.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "openapi": "tsx scripts/export-openapi.ts",
    "test:e2e": "node --test test/e2e/embed.e2e.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@hono/zod-openapi": "^1.6.0",
    "@kvesto/core": "workspace:^",
    "@kvesto/schema": "workspace:^",
    "@scalar/hono-api-reference": "^0.12.0",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.12.5",
    "kvesto": "workspace:^",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.0",
    "drizzle-kit": "^0.31.0",
    "playwright": "1.63.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
