{
  "name": "@kvesto/core",
  "version": "0.3.0",
  "description": "Framework-agnostic survey runtime: reads Kvesto survey JSON, renders it, and saves responses through a pluggable storage adapter.",
  "license": "MIT",
  "keywords": [
    "survey",
    "form",
    "questionnaire",
    "form-builder",
    "json",
    "kvesto"
  ],
  "homepage": "https://github.com/pavlovt/kvesto/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavlovt/kvesto.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/pavlovt/kvesto/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tailwindcss -i src/styles.css -o dist/styles.css",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kvesto/schema": "workspace:^"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "4.10.2",
    "fast-check": "^4.11.0",
    "happy-dom": "21.0.4",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
