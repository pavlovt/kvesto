# Point the app at a running Kvesto server. Leave unset to use localStorage.
# VITE_KVESTO_API=http://localhost:3000
# Admin API key, when the server runs with KVESTO_API_KEYS. It is visible to anyone who can load this app,
# so only use it for an admin tool you host privately.
# VITE_KVESTO_API_KEY=change-me
