{
  "name": "kvesto-monorepo",
  "private": true,
  "description": "Kvesto: an open source survey library with a framework-agnostic core, a REST server, a visual editor and a results dashboard.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "dev:server": "pnpm --filter @kvesto/server dev",
    "dev:editor": "pnpm --filter @kvesto/editor-app dev",
    "dev:dashboard": "pnpm --filter @kvesto/dashboard-app dev",
    "release:version": "node scripts/set-version.mjs",
    "release:check": "pnpm build && pnpm -r --filter \"./packages/*\" exec pnpm pack --dry-run"
  },
  "devDependencies": {
    "@braceml/svelte": "^0.4.0",
    "svelte": "^5.59.2",
    "typescript": "5.9.3"
  }
}
